<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/mytel_page_bg">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:paddingTop="32dp"
        android:paddingBottom="24dp"
        android:gravity="center_horizontal">
        <ImageView
            android:id="@+id/image"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:src="@drawable/mytel_logo_badge"
            android:contentDescription="@null" />
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/page_title"
            style="@style/default_text_style_800"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/app_wordmark"
            android:textColor="@color/mytel_text"
            android:textSize="30sp"
            android:gravity="center" />
        <View
            android:layout_width="48dp"
            android:layout_height="4dp"
            android:layout_marginTop="16dp"
            android:background="@color/mytel_orange" />
        <androidx.appcompat.widget.AppCompatTextView
            style="@style/MyTel.Ux.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/mytel_ux_welcome_title"
            android:gravity="center" />
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/message"
            style="@style/MyTel.Ux.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/mytel_ux_welcome_message"
            android:gravity="center" />
        <androidx.appcompat.widget.AppCompatTextView
            style="@style/MyTel.Ux.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:padding="12dp"
            android:drawableStart="@drawable/phone"
            android:drawablePadding="16dp"
            android:drawableTint="?attr/color_main1_500"
            android:text="@string/mytel_ux_welcome_calls" />
        <androidx.appcompat.widget.AppCompatTextView
            style="@style/MyTel.Ux.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:drawableStart="@drawable/chat_teardrop_text"
            android:drawablePadding="16dp"
            android:drawableTint="?attr/color_main1_500"
            android:text="@string/mytel_ux_welcome_messages" />
        <androidx.appcompat.widget.AppCompatTextView
            style="@style/MyTel.Ux.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:textSize="13sp"
            android:text="@string/mytel_ux_welcome_requirement"
            android:gravity="center" />
        <androidx.appcompat.widget.AppCompatTextView
            style="@style/MyTel.Ux.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:gravity="center"
            android:layout_marginTop="12dp"
            android:autoLink="web"
            android:linksClickable="true"
            android:textColorLink="?attr/color_main1_500"
            android:text="@string/mytel_website_url"
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
