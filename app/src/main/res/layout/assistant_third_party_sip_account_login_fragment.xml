<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <data>
        <import
            type="android.view.View" />
        <import
            type="android.text.InputType" />
        <variable
            name="backClickListener"
            type="View.OnClickListener" />
        <variable
            name="outboundProxyTooltipClickListener"
            type="View.OnClickListener" />
        <variable
            name="otherSetupClickListener"
            type="View.OnClickListener" />
        <variable
            name="viewModel"
            type="org.linphone.ui.assistant.viewmodel.ThirdPartySipAccountLoginViewModel" />
    </data>
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/mytel_page_bg">
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:clipToPadding="false">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="32dp"
                    app:layout_constraintWidth_max="600dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <androidx.appcompat.widget.AppCompatImageButton
                            android:id="@+id/back"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:padding="12dp"
                            android:background="@drawable/circle_transparent_button_background"
                            android:src="@drawable/caret_left"
                            app:tint="@color/mytel_text"
                            android:contentDescription="@string/content_description_go_back_icon"
                            android:onClick="@{backClickListener}" />
                        <ImageView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:layout_marginStart="8dp"
                            android:src="@drawable/mytel_logo_badge"
                            android:contentDescription="@null" />
                        <androidx.appcompat.widget.AppCompatTextView
                            style="@style/default_text_style_800"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="12dp"
                            android:text="@string/app_wordmark"
                            android:textColor="@color/mytel_text"
                            android:textSize="17sp" />
                    </LinearLayout>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/third_party_login_title"
                        style="@style/MyTel.Ux.Title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="22dp"
                        android:text="@string/mytel_ux_connect_title" />
                    <androidx.appcompat.widget.AppCompatTextView
                        style="@style/MyTel.Ux.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/mytel_ux_connect_message" />
                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/username_label"
                        style="@style/MyTel.Ux.Label"
                        android:text="@string/mytel_ux_extension"
                        android:labelFor="@id/username" />
                    <androidx.appcompat.widget.AppCompatEditText
                        android:id="@+id/username"
                        style="@style/MyTel.Ux.Input"
                        android:text="@={viewModel.username}"
                        android:enabled="@{!viewModel.registrationInProgress}"
                        android:inputType="text|textNoSuggestions"
                        android:autofillHints="username"
                        android:hint="@string/mytel_ux_extension_hint" />
                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/password_label"
                        style="@style/MyTel.Ux.Label"
                        android:text="@string/password"
                        android:labelFor="@id/password" />
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <androidx.appcompat.widget.AppCompatEditText
                            android:id="@+id/password"
                            style="@style/MyTel.Ux.Input"
                            android:paddingEnd="64dp"
                            android:text="@={viewModel.password}"
                            android:enabled="@{!viewModel.registrationInProgress}"
                            android:autofillHints="password"
                            android:hint="@string/password"
                            passwordInputType="@{viewModel.showPassword ? InputType.TYPE_CLASS_TEXT | InputType.TYPE_TEXT_VARIATION_VISIBLE_PASSWORD : InputType.TYPE_CLASS_TEXT | InputType.TYPE_TEXT_VARIATION_PASSWORD, default=textPassword}" />
                        <androidx.appcompat.widget.AppCompatImageButton
                            android:id="@+id/eye"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_gravity="end|center_vertical"
                            android:layout_marginEnd="4dp"
                            android:padding="12dp"
                            android:background="@drawable/circle_transparent_button_background"
                            android:src="@{viewModel.showPassword ? @drawable/eye_slash : @drawable/eye, default=@drawable/eye}"
                            app:tint="?attr/color_main2_600"
                            android:contentDescription="@string/content_description_toggle_password_visibility"
                            android:onClick="@{() -> viewModel.toggleShowPassword()}" />
                    </FrameLayout>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/domain_label"
                        style="@style/MyTel.Ux.Label"
                        android:text="@string/mytel_ux_server"
                        android:labelFor="@id/domain" />
                    <androidx.appcompat.widget.AppCompatEditText
                        android:id="@+id/domain"
                        style="@style/MyTel.Ux.Input"
                        android:text="@={viewModel.domain}"
                        android:enabled="@{!viewModel.registrationInProgress}"
                        android:inputType="textUri"
                        android:imeOptions="actionDone"
                        android:textDirection="ltr"
                        android:hint="@string/mytel_ux_server_hint" />
                    <androidx.appcompat.widget.AppCompatTextView
                        style="@style/MyTel.Ux.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textSize="12sp"
                        android:text="@string/mytel_ux_server_help" />
                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/advanced_settings"
                        style="@style/MyTel.Ux.Section"
                        android:layout_marginTop="16dp"
                        android:text="@string/mytel_ux_advanced_setup"
                        android:drawableEnd="@{viewModel.expandAdvancedSettings ? @drawable/caret_up : @drawable/caret_down, default=@drawable/caret_down}"
                        android:drawableTint="?attr/color_main2_600"
                        android:enabled="@{!viewModel.registrationInProgress}"
                        android:onClick="@{() -> viewModel.toggleAdvancedSettingsExpand()}" />
                    <LinearLayout
                        android:id="@+id/advanced_settings_group"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="@{viewModel.expandAdvancedSettings ? View.VISIBLE : View.GONE, default=gone}">
                        <androidx.appcompat.widget.AppCompatTextView
                            style="@style/MyTel.Ux.Body"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="13sp"
                            android:text="@string/mytel_ux_advanced_help" />
                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/transport_label"
                            style="@style/MyTel.Ux.Label"
                            android:text="@string/assistant_sip_account_transport_protocol"
                            android:labelFor="@id/transport" />
                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="56dp">
                            <androidx.appcompat.widget.AppCompatSpinner
                                android:id="@+id/transport"
                                style="@style/default_text_style"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:paddingStart="16dp"
                                android:paddingEnd="40dp"
                                android:background="@drawable/edit_text_background"
                                android:popupBackground="@drawable/shape_squircle_white_background"
                                android:overlapAnchor="false"
                                android:spinnerMode="dropdown"
                                android:enabled="@{!viewModel.registrationInProgress}" />
                            <ImageView
                                android:id="@+id/transport_caret"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_gravity="end|center_vertical"
                                android:layout_marginEnd="16dp"
                                android:src="@drawable/caret_down"
                                app:tint="?attr/color_main2_600"
                                android:importantForAccessibility="no"
                                android:contentDescription="@null" />
                        </FrameLayout>
                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/display_name_label"
                            style="@style/MyTel.Ux.Label"
                            android:text="@string/sip_address_display_name"
                            android:labelFor="@id/display_name" />
                        <androidx.appcompat.widget.AppCompatEditText
                            android:id="@+id/display_name"
                            style="@style/MyTel.Ux.Input"
                            android:text="@={viewModel.displayName}"
                            android:enabled="@{!viewModel.registrationInProgress}"
                            android:inputType="textPersonName|textCapWords"
                            android:hint="@string/sip_address_display_name" />
                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/authentication_id_label"
                            style="@style/MyTel.Ux.Label"
                            android:text="@string/authentication_id"
                            android:labelFor="@id/authentication_id" />
                        <androidx.appcompat.widget.AppCompatEditText
                            android:id="@+id/authentication_id"
                            style="@style/MyTel.Ux.Input"
                            android:text="@={viewModel.authId}"
                            android:enabled="@{!viewModel.registrationInProgress}"
                            android:inputType="text|textNoSuggestions"
                            android:hint="@string/authentication_id" />
                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/proxy_label"
                            style="@style/MyTel.Ux.Label"
                            android:text="@string/account_settings_sip_proxy_url_title"
                            android:labelFor="@id/proxy" />
                        <androidx.appcompat.widget.AppCompatEditText
                            android:id="@+id/proxy"
                            style="@style/MyTel.Ux.Input"
                            android:text="@={viewModel.proxy}"
                            android:enabled="@{!viewModel.registrationInProgress}"
                            android:inputType="textUri"
                            android:textDirection="ltr"
                            android:hint="@string/account_settings_sip_proxy_url_title" />
                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/outbound_proxy_label"
                            style="@style/MyTel.Ux.Label"
                            android:text="@string/account_settings_outbound_proxy_title"
                            android:labelFor="@id/outbound_proxy" />
                        <androidx.appcompat.widget.AppCompatEditText
                            android:id="@+id/outbound_proxy"
                            style="@style/MyTel.Ux.Input"
                            android:text="@={viewModel.outboundProxy}"
                            android:enabled="@{!viewModel.registrationInProgress}"
                            android:inputType="textUri"
                            android:textDirection="ltr"
                            android:hint="@string/account_settings_outbound_proxy_title" />
                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/outbound_proxy_tooltip"
                            android:enabled="@{!viewModel.registrationInProgress}"
                            style="@style/MyTel.Ux.Section"
                            android:text="@string/content_description_click_for_more_info"
                            android:drawableStart="@drawable/info"
                            android:drawablePadding="12dp"
                            android:drawableTint="?attr/color_main2_600"
                            android:textSize="13sp"
                            android:onClick="@{outboundProxyTooltipClickListener}" />
                        <androidx.appcompat.widget.AppCompatTextView
                            style="@style/MyTel.Ux.Section"
                            android:text="@string/mytel_ux_other_setup"
                            android:visibility="gone"
                            android:enabled="@{!viewModel.registrationInProgress}"
                            android:drawableEnd="@drawable/caret_right"
                            android:drawableTint="?attr/color_main2_600"
                            android:textSize="14sp"
                            android:onClick="@{otherSetupClickListener}" />
                    </LinearLayout>
                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/login"
                        style="@style/MyTel.Ux.Primary"
                        android:layout_marginTop="24dp"
                        android:enabled="@{viewModel.loginEnabled &amp;&amp; !viewModel.registrationInProgress, default=false}"
                        android:text="@{viewModel.registrationInProgress ? @string/mytel_ux_connecting : @string/mytel_ux_connect}"
                        android:onClick="@{() -> viewModel.login()}" />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:gravity="center"
                        android:visibility="@{viewModel.registrationInProgress ? View.VISIBLE : View.GONE, default=gone}">
                        <ProgressBar
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:contentDescription="@string/mytel_ux_connecting"
                            android:indeterminateTint="@color/mytel_blue" />
                    </LinearLayout>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/connection_feedback"
                        style="@style/MyTel.Ux.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="@{viewModel.connectionFeedback}"
                        android:textSize="14sp"
                        android:accessibilityLiveRegion="polite"
                        android:visibility="@{viewModel.connectionFeedback == null || viewModel.connectionFeedback.empty ? View.GONE : View.VISIBLE, default=gone}" />
                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/cancel_registration"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:layout_marginTop="12dp"
                        android:textAllCaps="false"
                        android:text="@string/mytel_ux_cancel_connection"
                        android:textSize="15sp"
                        android:textColor="@color/secondary_button_label_color"
                        android:background="@drawable/secondary_button_background"
                        android:onClick="@{() -> viewModel.cancelLogin()}"
                        android:visibility="@{viewModel.registrationInProgress ? View.VISIBLE : View.GONE, default=gone}" />
                    <androidx.appcompat.widget.AppCompatTextView
                        style="@style/MyTel.Ux.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:textSize="13sp"
                        android:text="@string/mytel_ux_setup_help" />
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </ScrollView>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>
</layout>
