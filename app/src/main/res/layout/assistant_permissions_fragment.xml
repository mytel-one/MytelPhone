<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <data>
        <import type="android.view.View" />
        <variable name="backClickListener" type="View.OnClickListener" />
        <variable name="skipClickListener" type="View.OnClickListener" />
        <variable name="grantAllClickListener" type="View.OnClickListener" />
        <variable name="viewModel" type="org.linphone.ui.assistant.viewmodel.PermissionsViewModel" />
    </data>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="?attr/color_main2_000">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="64dp"
            android:paddingStart="12dp"
            android:paddingEnd="20dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <ImageButton
                android:id="@+id/back"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:onClick="@{backClickListener}"
                android:src="@drawable/caret_left"
                android:padding="12dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/content_description_go_back_icon"
                app:tint="?attr/color_main2_600" />
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/grant_permissions_title"
                style="@style/MyTel.Ux.Title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:textSize="22sp"
                android:text="@string/mytel_ux_permission_title" />
        </LinearLayout>
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingStart="24dp"
            android:paddingEnd="24dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="20dp">
                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/subtitle"
                    style="@style/MyTel.Ux.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:text="@string/mytel_ux_permission_intro" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    android:visibility="@{viewModel.recordAudioPermissionGranted ? View.GONE : View.VISIBLE}">
                    <ImageView
                        android:id="@+id/record_audio_icon"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginEnd="16dp"
                        android:padding="8dp"
                        android:background="@drawable/circle_light_blue_button_background"
                        android:src="@drawable/microphone"
                        android:contentDescription="@null"
                        app:tint="?attr/color_main1_500" />
                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/record_audio_title"
                        style="@style/MyTel.Ux.Body"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/mytel_ux_permission_microphone" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    android:visibility="@{viewModel.readContactsPermissionGranted ? View.GONE : View.VISIBLE}">
                    <ImageView
                        android:id="@+id/read_contacts_icon"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginEnd="16dp"
                        android:padding="8dp"
                        android:background="@drawable/circle_light_blue_button_background"
                        android:src="@drawable/address_book"
                        android:contentDescription="@null"
                        app:tint="?attr/color_main1_500" />
                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/read_contacts_title"
                        style="@style/MyTel.Ux.Body"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/mytel_ux_permission_contacts" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    android:visibility="@{viewModel.postNotificationsPermissionGranted ? View.GONE : View.VISIBLE}">
                    <ImageView
                        android:id="@+id/post_notifications_icon"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginEnd="16dp"
                        android:padding="8dp"
                        android:background="@drawable/circle_light_blue_button_background"
                        android:src="@drawable/bell_ringing"
                        android:contentDescription="@null"
                        app:tint="?attr/color_main1_500" />
                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/post_notifications_title"
                        style="@style/MyTel.Ux.Body"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/mytel_ux_permission_notifications" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    android:visibility="@{viewModel.cameraPermissionGranted ? View.GONE : View.VISIBLE}">
                    <ImageView
                        android:id="@+id/access_camera_icon"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginEnd="16dp"
                        android:padding="8dp"
                        android:background="@drawable/circle_light_blue_button_background"
                        android:src="@drawable/video_camera"
                        android:contentDescription="@null"
                        app:tint="?attr/color_main1_500" />
                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/access_camera_title"
                        style="@style/MyTel.Ux.Body"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/mytel_ux_permission_camera" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    android:visibility="@{viewModel.accessLocalNetworkPermissionGranted ? View.GONE : View.VISIBLE}">
                    <ImageView
                        android:id="@+id/access_local_network_icon"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginEnd="16dp"
                        android:padding="8dp"
                        android:background="@drawable/circle_light_blue_button_background"
                        android:src="@drawable/share_network"
                        android:contentDescription="@null"
                        app:tint="?attr/color_main1_500" />
                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/access_local_network_title"
                        style="@style/MyTel.Ux.Body"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/mytel_ux_permission_network" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="12dp"
            android:paddingBottom="16dp">
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/grant_all_permissions"
                style="@style/MyTel.Ux.Primary"
                android:onClick="@{grantAllClickListener}"
                android:text="@string/mytel_ux_permission_continue" />
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/skip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:layout_marginTop="8dp"
                android:onClick="@{skipClickListener}"
                android:background="?attr/selectableItemBackground"
                android:textAllCaps="false"
                android:textSize="16sp"
                android:textColor="?attr/color_main1_500"
                android:text="@string/mytel_ux_permission_later" />
        </LinearLayout>
    </LinearLayout>
</layout>
