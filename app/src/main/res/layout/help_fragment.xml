<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <data>
        <import type="android.view.View" />
        <variable name="backClickListener" type="View.OnClickListener" />
        <variable name="websiteClickListener" type="View.OnClickListener" />
        <variable name="aboutClickListener" type="View.OnClickListener" />
        <variable name="userGuideClickListener" type="View.OnClickListener" />
        <variable name="supportClickListener" type="View.OnClickListener" />
        <variable name="phoneClickListener" type="View.OnClickListener" />
        <variable name="emailClickListener" type="View.OnClickListener" />
        <variable name="licensesClickListener" type="View.OnClickListener" />
        <variable name="debugClickListener" type="View.OnClickListener" />
        <variable name="viewModel" type="org.linphone.ui.main.help.viewmodel.HelpViewModel" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/mytel_page_bg">
        <ImageView
            android:id="@+id/back"
            style="@style/icon_top_bar_button_style"
            android:layout_width="@dimen/top_bar_height"
            android:layout_height="@dimen/top_bar_height"
            android:onClick="@{backClickListener}"
            android:src="@drawable/caret_left"
            android:contentDescription="@string/content_description_go_back_icon"
            app:tint="?attr/color_main1_500"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/title"
            style="@style/main_page_title_style"
            android:layout_width="0dp"
            android:layout_height="@dimen/top_bar_height"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:text="@string/mytel_help_title"
            app:layout_constraintStart_toEndOf="@id/back"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
        <ScrollView
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:clipToPadding="false"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/title"
            app:layout_constraintBottom_toBottomOf="parent">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="24dp">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_margin="16dp"
                    android:orientation="vertical"
                    app:layout_constraintWidth_max="@dimen/section_max_width"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/shape_squircle_white_background"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:padding="24dp">
                        <ImageView
                            android:layout_width="80dp"
                            android:layout_height="80dp"
                            android:contentDescription="@null"
                            android:src="@drawable/mytel_logo_badge" />
                        <androidx.appcompat.widget.AppCompatTextView
                            style="@style/MyTel.Ux.Title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:gravity="center"
                            android:text="@string/mytel_product_name" />
                        <androidx.appcompat.widget.AppCompatTextView
                            style="@style/default_text_style"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:gravity="center"
                            android:text="@string/mytel_about_summary"
                            android:textColor="?attr/color_main2_600"
                            android:textSize="15sp" />
                        <androidx.appcompat.widget.AppCompatTextView
                            style="@style/MyTel.Ux.Primary"
                            android:layout_marginTop="20dp"
                            android:onClick="@{websiteClickListener}"
                            android:text="@string/mytel_official_website_title" />
                        <LinearLayout
                            android:id="@+id/version"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:gravity="center"
                            android:minHeight="48dp"
                            android:onClick="@{() -> viewModel.versionClicked()}"
                            android:orientation="horizontal">
                            <androidx.appcompat.widget.AppCompatTextView
                                style="@style/default_text_style"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/help_about_version_title"
                                android:textColor="?attr/color_main2_600" />
                            <androidx.appcompat.widget.AppCompatTextView
                                style="@style/default_text_style"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:text="@{viewModel.version}"
                                android:textColor="?attr/color_main2_600" />
                        </LinearLayout>
                        <androidx.appcompat.widget.AppCompatTextView
                            style="@style/default_text_style"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="@string/mytel_brand_copyright"
                            android:textColor="?attr/color_main2_500"
                            android:textSize="12sp" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/shape_squircle_white_background"
                        android:orientation="vertical"
                        android:padding="8dp">
                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/support"
                            style="@style/MyTel.Ux.Section"
                            android:layout_marginTop="0dp"
                            android:onClick="@{supportClickListener}"
                            android:text="@string/mytel_contact_title"
                            android:drawableStart="@drawable/headset"
                            android:drawablePadding="16dp"
                            app:drawableTint="?attr/color_main1_500" />
                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/phone"
                            style="@style/MyTel.Ux.Section"
                            android:layout_marginTop="0dp"
                            android:onClick="@{phoneClickListener}"
                            android:text="@string/mytel_support_phone"
                            android:drawableStart="@drawable/phone"
                            android:drawablePadding="16dp"
                            app:drawableTint="?attr/color_main1_500" />
                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/email"
                            style="@style/MyTel.Ux.Section"
                            android:layout_marginTop="0dp"
                            android:onClick="@{emailClickListener}"
                            android:text="@string/mytel_support_email"
                            android:drawableStart="@drawable/envelope_simple"
                            android:drawablePadding="16dp"
                            app:drawableTint="?attr/color_main1_500" />
                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/about"
                            style="@style/MyTel.Ux.Section"
                            android:layout_marginTop="0dp"
                            android:onClick="@{aboutClickListener}"
                            android:text="@string/mytel_about_company_title"
                            android:drawableStart="@drawable/info"
                            android:drawablePadding="16dp"
                            app:drawableTint="?attr/color_main1_500" />
                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/resources"
                            style="@style/MyTel.Ux.Section"
                            android:layout_marginTop="0dp"
                            android:onClick="@{userGuideClickListener}"
                            android:text="@string/mytel_resources_title"
                            android:drawableStart="@drawable/book_open_text"
                            android:drawablePadding="16dp"
                            app:drawableTint="?attr/color_main1_500" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/shape_squircle_white_background"
                        android:orientation="vertical"
                        android:padding="8dp">
                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/debug"
                            style="@style/MyTel.Ux.Section"
                            android:layout_marginTop="0dp"
                            android:onClick="@{debugClickListener}"
                            android:text="@string/mytel_diagnostics_title"
                            android:drawableStart="@drawable/wrench"
                            android:drawablePadding="16dp"
                            app:drawableTint="?attr/color_main1_500" />
                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/licenses"
                            style="@style/MyTel.Ux.Section"
                            android:layout_marginTop="0dp"
                            android:onClick="@{licensesClickListener}"
                            android:text="@string/mytel_software_licenses_title"
                            android:drawableStart="@drawable/check_square_offset"
                            android:drawablePadding="16dp"
                            app:drawableTint="?attr/color_main1_500" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </ScrollView>
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
