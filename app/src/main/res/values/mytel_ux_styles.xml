<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="MyTel.Ux.Title" parent="default_text_style_800">
        <item name="android:textSize">26sp</item>
        <item name="android:textColor">@color/mytel_text</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>
    <style name="MyTel.Ux.Body" parent="default_text_style">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/mytel_text</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>
    <style name="MyTel.Ux.Label" parent="default_text_style_600">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">20dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/mytel_text</item>
    </style>
    <style name="MyTel.Ux.Input" parent="default_text_style">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/mytel_text</item>
        <item name="android:textColorHint">?attr/color_main2_500</item>
        <item name="android:background">@drawable/edit_text_background</item>
        <item name="android:singleLine">true</item>
        <item name="android:imeOptions">actionNext</item>
    </style>
    <style name="MyTel.Ux.Primary" parent="primary_button_label_style">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/mytel_ux_primary_label</item>
        <item name="android:background">@drawable/mytel_ux_primary_button_background</item>
    </style>
    <style name="MyTel.Ux.Section" parent="section_header_style">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">16dp</item>
        <item name="android:paddingBottom">16dp</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/mytel_text</item>
        <item name="android:background">@drawable/squircle_transparent_button_background</item>
    </style>
</resources>

